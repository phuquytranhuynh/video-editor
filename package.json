{
  "name": "video-editor-local",
  "productName": "Video Editor Local",
  "version": "1.0.0",
  "description": "Phần mềm dựng video chạy local (giao diện tham khảo Adobe Premiere Pro)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "node scripts/build-stt.mjs",
    "build:stt": "node scripts/build-stt.mjs"
  },
  "build": {
    "appId": "local.video.editor",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2",
    "@huggingface/transformers": "4.3.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "overrides": {
    "onnxruntime-node": "file:./stubs/onnxruntime-node",
    "sharp": "file:./stubs/sharp"
  }
}